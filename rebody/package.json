{
  "name": "rebody",
  "version": "0.1.0",
  "private": true,
  "description": "ReBody(리바디) — 교대근무자를 위한 Cycle 기반 AI 단식·영양 스케줄링 (Android only)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "fn:serve": "supabase functions serve --env-file supabase/.env.local",
    "fn:deploy": "supabase functions deploy",
    "eval:scanner": "tsx scripts/eval-food-scanner.ts",
    "probe:mfds": "tsx scripts/probe-mfds.ts",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform android",
    "update": "eas update --branch production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@supabase/supabase-js": "^2.110.8",
    "expo": "~53.0.0",
    "expo-camera": "~16.1.0",
    "expo-constants": "~17.1.0",
    "expo-device": "~7.1.0",
    "expo-file-system": "~18.1.0",
    "expo-image-manipulator": "~13.1.0",
    "expo-linking": "~7.1.0",
    "expo-notifications": "~0.31.0",
    "expo-router": "~5.0.0",
    "expo-sharing": "~13.1.0",
    "expo-status-bar": "~2.2.0",
    "luxon": "^3.7.2",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-purchases": "^8.2.0",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.10.0",
    "react-native-url-polyfill": "^2.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.7.2",
    "@types/react": "~19.0.10",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.2",
    "typescript": "5.8"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
