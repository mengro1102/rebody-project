# ─────────────────────────────────────────────────────────────
# 앱(클라이언트) — EXPO_PUBLIC_ 접두사가 붙은 값은 번들에 그대로 박힌다.
# 비밀키를 절대 여기 두지 말 것. Gemini/MFDS 키는 Edge Function 전용이다.
# ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

EXPO_PUBLIC_ENV=development
# mock: Play Console 등록 전. 페이월 UI만 확인 가능.
# live: 실제 Google Play Billing 사용.
EXPO_PUBLIC_BILLING_MODE=mock
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxx

# 개인정보처리방침 공개 URL (Play Console 필수 항목)
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://mengro1102.github.io/rebody-policy/

# ─────────────────────────────────────────────────────────────
# Edge Function 전용 — supabase secrets set 으로 등록한다.
#   supabase secrets set --env-file supabase/.env.local
# 이 값들은 클라이언트에 절대 노출되지 않는다.
# ─────────────────────────────────────────────────────────────

# Gemini. 모델 ID를 환경변수로 둬서 단가 변동/모델 종료 시 재배포 없이 교체한다.
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.1-flash-lite

# 식약처 공공데이터포털.
# data.go.kr은 Encoding/Decoding 두 형태의 키를 준다. 현행 '일반 인증키'는 64자 hex라
# 두 형태가 동일하므로 그대로 넣으면 된다. 만약 +, /, = 가 섞인 구형 키라면
# 반드시 "디코딩" 키를 넣을 것 (코드가 URLSearchParams로 다시 인코딩한다).
MFDS_SERVICE_KEY=
# 15127578 '식품영양성분DB정보'의 요청주소. 접미사 02가 맞다 (01은 구버전 — 404).
# data.go.kr 상세페이지의 '요청주소'와 반드시 대조할 것.
MFDS_API_BASE=https://apis.data.go.kr/1471000/FoodNtrCpntDbInfo02/getFoodNtrCpntDbInq02
MFDS_NAME_PARAM=FOOD_NM_KR

# FCM HTTP v1 (서비스 계정). 레거시 서버 키는 사용 불가.
FCM_PROJECT_ID=rebody-xxxxx
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@rebody-xxxxx.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY 는
# Supabase가 Edge Function 런타임에 자동 주입하므로 별도 등록 불필요.
